# Copy to .env and adjust. All variables are read by cxr_reliability.config.settings
# (prefix CXR_). Never commit .env. Never put real patient data anywhere in this project.

CXR_ENV=dev
CXR_DEVICE=cpu                      # cpu | cuda
CXR_SEED=42

# Paths (relative to repo root, or absolute)
CXR_DATA_DIR=data
CXR_MODELS_DIR=models
CXR_OUTPUTS_DIR=outputs
CXR_LOGS_DIR=logs
CXR_CONFIGS_DIR=configs

# NIH ChestX-ray14 dataset root (Phase 2+).
# Set this to the absolute path of the folder that contains
# Data_Entry_2017.csv and the images_001/ … images_012/ subdirectories.
# Example (Windows):
#   CXR_DATASET_ROOT=C:\Users\PARAS\Desktop\AI SEM 5 B1 G5\PROJECT\cxr-reliability\cxr-reliability\dataset
CXR_DATASET_ROOT=dataset

# Versioned thresholds file under configs/thresholds/ (without .yaml)
CXR_THRESHOLDS_VERSION=v0_prd_defaults
CXR_PIPELINE_CONFIG=configs/pipeline.yaml

# Experiment tracking
CXR_MLFLOW_TRACKING_URI=file:./outputs/mlruns

# API
CXR_API_HOST=0.0.0.0
CXR_API_PORT=8000
CXR_MAX_UPLOAD_MB=20

# Dataset download credentials (only needed by scripts/download_*.py)
KAGGLE_USERNAME=
KAGGLE_KEY=
